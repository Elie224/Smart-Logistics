{
  "name": "Weather Ingestion Every 30 Minutes - 5 Cities",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "1",
      "name": "Cron Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [\n  { json: { city: 'Paris' } },\n  { json: { city: 'Lille' } }\n];"
      },
      "id": "2",
      "name": "Prepare Cities",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.openweathermap.org/data/2.5/weather",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{$json.city + ',fr'}}"
            },
            {
              "name": "appid",
              "value": "={{$env.OPENWEATHER_API_KEY}}"
            },
            {
              "name": "units",
              "value": "metric"
            }
          ]
        },
        "options": {}
      },
      "id": "3",
      "name": "OpenWeather API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "city",
              "name": "city",
              "type": "string",
              "value": "={{$('Prepare Cities').item.json.city}}"
            },
            {
              "id": "temperature",
              "name": "temperature",
              "type": "number",
              "value": "={{$json.main.temp}}"
            },
            {
              "id": "humidity",
              "name": "humidity",
              "type": "number",
              "value": "={{$json.main.humidity}}"
            },
            {
              "id": "weather",
              "name": "weather",
              "type": "string",
              "value": "={{$json.weather[0].description}}"
            },
            {
              "id": "wind_speed",
              "name": "wind_speed",
              "type": "number",
              "value": "={{$json.wind.speed}}"
            },
            {
              "id": "raw_payload",
              "name": "raw_payload",
              "type": "json",
              "value": "={{$json}}"
            }
          ]
        },
        "options": {}
      },
      "id": "4",
      "name": "Set Weather Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        980,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO weather_data (city, temperature, humidity, weather, wind_speed, raw_payload) VALUES ($1, $2, $3, $4, $5, $6::jsonb);",
        "options": {
          "queryReplacement": "={{ [$json.city, $json.temperature, $json.humidity, $json.weather, $json.wind_speed, JSON.stringify($json.raw_payload)] }}"
        }
      },
      "id": "5",
      "name": "Store In PostgreSQL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1240,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "7e02c4a3-d32d-4de2-8226-8cabadeb714c",
          "name": "Postgres Smart Logistics"
        }
      }
    }
  ],
  "connections": {
    "Cron Trigger": {
      "main": [
        [
          {
            "node": "Prepare Cities",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Cities": {
      "main": [
        [
          {
            "node": "OpenWeather API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenWeather API": {
      "main": [
        [
          {
            "node": "Set Weather Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Weather Payload": {
      "main": [
        [
          {
            "node": "Store In PostgreSQL",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
